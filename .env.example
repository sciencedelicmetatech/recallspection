# ============================================================
# Recallspection — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Required in production ---------------------------------

# Master secret for ExactMemory HMAC tags. 32+ random bytes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECALLSPECTION_EXACT_SECRET="change-me"

# Admin key for /admin/* routes. Fails closed if unset.
RECALLSPECTION_ADMIN_KEY="change-me"

# Signup secret for POST /signup. Leave unset to disable public signup.
RECALLSPECTION_SIGNUP_SECRET="change-me"


# --- Storage paths (mount a persistent disk) ----------------

RECALLSPECTION_MEMORY_FILE="/data/memory.db"
RECALLSPECTION_SWSTM_FILE="/data/swstm.pt"
RECALLSPECTION_DB_FILE="/data/keys.db"
RECALLSPECTION_EXACT_LOG="/data/transparency.log"


# --- S3 Object Lock anchor ----------------------------------

# Bucket MUST be created with Object Lock enabled. Cannot be added later.
RECALLSPECTION_S3_BUCKET=""
RECALLSPECTION_S3_REGION="us-east-1"
RECALLSPECTION_S3_RETENTION_DAYS="30"

# Prefer an IAM role or instance profile over static keys in production.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""


# --- Server -------------------------------------------------

HOST="0.0.0.0"
PORT="8000"


# --- Optional ------------------------------------------------

# ExactMemory tag length in bytes (default 32).
RECALLSPECTION_TAG_LEN="32"

# Auto-save interval in seconds (default 60).
RECALLSPECTION_AUTOSAVE_INTERVAL="60"

# Max request body size in bytes (default 131072 = 128 KB).
RECALLSPECTION_MAX_BODY="131072"